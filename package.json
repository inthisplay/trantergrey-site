{
  "name": "trantergrey-site",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:next": "next dev -p 3101",
    "dev:cloudflare": "npm run dev",
    "db:migrate:local": "wrangler d1 migrations apply TG_DATA --local --persist-to .wrangler/state",
    "build": "next build",
    "build:site": "node scripts/build-static-site.mjs",
    "check:cloudflare-release": "npm run build:site && node scripts/check-cloudflare-release.mjs",
    "start": "next start",
    "lint": "next lint"
  },
  "dependencies": {
    "@videojs/mux-data": "^10.3.0",
    "@videojs/mux-video": "^10.3.0",
    "@videojs/react": "^10.3.0",
    "@vimeo/player": "^2.30.4",
    "@zip.js/zip.js": "^2.24.0",
    "fuse.js": "^7.5.0",
    "next": "^16.4.5",
    "pixelarticons": "^2.4.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "video.js": "^10.3.0"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.0.0",
    "wrangler": "^4.158.0"
  }
}
