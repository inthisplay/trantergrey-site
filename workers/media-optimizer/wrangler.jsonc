{
  "name": "trantergrey-media-optimizer",
  "main": "index.ts",
  "compatibility_date": "2026-10-20",
  "workers_dev": false,
  "preview_urls": false,
  "images": { "binding": "IMAGES" },
  "media": { "binding": "MEDIA" },
  "d1_databases": [{ "binding": "TG_DATA", "database_name": "trantergrey-site-data", "database_id": "a7a66fec-71a4-464a-9c14-104d2e820c17" }],
  "r2_buckets": [{ "binding": "PRODUCTION_ARCHIVE", "bucket_name": "trantergrey-production-archive" }]
}
